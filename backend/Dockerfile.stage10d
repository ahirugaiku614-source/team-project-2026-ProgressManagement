# 管理者が検証した固定digestを必須引数にする。可変タグへの暗黙fallbackは禁止。
ARG STAGE10_PYTHON_BASE
FROM ${STAGE10_PYTHON_BASE}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY migrations ./migrations
COPY tests ./tests
CMD ["uvicorn", "app.synthetic_asgi:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
