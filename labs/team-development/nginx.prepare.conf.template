# 作業基準を作る前の合成準備画面専用。code-serverへの接続経路は存在しない。
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
  include /etc/nginx/mime.types;
  access_log off;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  client_max_body_size 1m;
  server {
    listen 8443 ssl;
    ssl_certificate /run/tls/server.crt;
    ssl_certificate_key /run/tls/server.key;
    root /srv/web;
    index stage10d-native.html;
    location / { try_files $uri $uri/ /stage10d-native.html; }
    location /api/ {
      proxy_pass http://backend:8000;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
    }
    location /code-server/ { return 403; }
  }
}
