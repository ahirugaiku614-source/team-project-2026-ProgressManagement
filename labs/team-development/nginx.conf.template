# Stage 10承認前には使用しない。秘密値・本文・Cookieをアクセスログへ残さない。
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8443 ssl;
    ssl_certificate /run/tls/server.crt;
    ssl_certificate_key /run/tls/server.key;
    root /srv/web;
    location / { try_files $uri $uri/ /index.html; }
    location /api/ {
      proxy_pass http://backend:8000;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
    }
    location = /_editor_a_auth {
      internal;
      proxy_pass http://backend:8000/api/editor-gateway/${WORKSPACE_A_ID};
      proxy_pass_request_body off;
      proxy_set_header Content-Length '';
      proxy_set_header Cookie $http_cookie;
    }
    location = /_editor_b_auth {
      internal;
      proxy_pass http://backend:8000/api/editor-gateway/${WORKSPACE_B_ID};
      proxy_pass_request_body off;
      proxy_set_header Content-Length '';
      proxy_set_header Cookie $http_cookie;
    }
    location /code-server/${WORKSPACE_A_ID}/ {
      error_page 418 = @member_a_socket;
      if ($http_upgrade = websocket) { return 418; }
      auth_request /_editor_a_auth;
      proxy_pass http://member-a:8080/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 60s;
      proxy_cookie_path / /code-server/${WORKSPACE_A_ID}/;
    }
    location /code-server/${WORKSPACE_B_ID}/ {
      error_page 418 = @member_b_socket;
      if ($http_upgrade = websocket) { return 418; }
      auth_request /_editor_b_auth;
      proxy_pass http://member-b:8080/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 60s;
      proxy_cookie_path / /code-server/${WORKSPACE_B_ID}/;
    }
    # WebSocketは新規接続だけのauth_requestで終わらせず、専用gatewayへ渡す。
    # gateway自身が最初と継続中の両方でFastAPIを検証する。
    location @member_a_socket {
      proxy_pass http://session-gateway:8090;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Origin $http_origin;
    }
    location @member_b_socket {
      proxy_pass http://session-gateway:8090;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Origin $http_origin;
    }
    location /code-server/ { return 403; }
  }
}
